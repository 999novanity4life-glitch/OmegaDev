--!nocheck
return function(t, load)
	local Validate = load("src/shared/Validate")
	local describe, it, expect = t.describe, t.it, t.expect

	describe("Validate", function()
		it("rejects NaN and infinity", function()
			expect(Validate.finiteNumber(0 / 0)).toBeFalsy()
			expect(Validate.finiteNumber(math.huge)).toBeFalsy()
			expect(Validate.finiteNumber(-math.huge)).toBeFalsy()
			expect(Validate.finiteNumber(0 / 0, 0, 10)).toBeFalsy()
		end)
		it("enforces ranges", function()
			expect(Validate.finiteNumber(5, 0, 10)).toBeTruthy()
			expect(Validate.finiteNumber(11, 0, 10)).toBeFalsy()
			expect(Validate.finiteNumber("5")).toBeFalsy()
		end)
		it("integer rejects fractions", function()
			expect(Validate.integer(3)).toBeTruthy()
			expect(Validate.integer(3.5)).toBeFalsy()
		end)
		it("shortString checks length and type", function()
			expect(Validate.shortString("hi", 10)).toBeTruthy()
			expect(Validate.shortString(string.rep("a", 11), 10)).toBeFalsy()
			expect(Validate.shortString(5, 10)).toBeFalsy()
		end)
		it("oneOf uses an allow list", function()
			local allowed = { Sword = true }
			expect(Validate.oneOf("Sword", allowed)).toBeTruthy()
			expect(Validate.oneOf("Bow", allowed)).toBeFalsy()
			expect(Validate.oneOf(nil, allowed)).toBeFalsy()
		end)
	end)
end
