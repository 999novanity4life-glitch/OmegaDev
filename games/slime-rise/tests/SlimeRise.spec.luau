--!nocheck
return function(t, load)
	local SlimeCurve = load("src/shared/SlimeCurve")
	local Powers = load("src/shared/Powers")
	local Crowns = load("src/shared/Crowns")
	local Config = load("src/shared/Config")
	local describe, it, expect = t.describe, t.it, t.expect

	describe("SlimeCurve", function()
		it("stays at the base before the rise starts", function()
			expect(SlimeCurve.height(0, 10, 60, -3, 200, 1.25)).toBe(-3)
		end)
		it("reaches the top at the end and stays there", function()
			expect(SlimeCurve.height(70, 10, 60, -3, 200, 1.25)).toBe(200)
			expect(SlimeCurve.height(500, 10, 60, -3, 200, 1.25)).toBe(200)
		end)
		it("starts slow: below the straight line at the midpoint", function()
			local mid = SlimeCurve.height(40, 10, 60, 0, 100, 1.25)
			expect(mid < 50).toBeTruthy()
			expect(mid > 0).toBeTruthy()
		end)
		it("never goes down over time", function()
			local last = -math.huge
			for now = 0, 80, 0.5 do
				local y = SlimeCurve.height(now, 10, 60, -3, 200, 1.25)
				expect(y >= last).toBeTruthy()
				last = y
			end
		end)
		it("handles a zero duration", function()
			expect(SlimeCurve.height(0, 0, 0, 0, 50, 1.25)).toBe(50)
		end)
		it("touching uses the margin", function()
			expect(SlimeCurve.isTouching(10.4, 10, 0.5)).toBeTruthy()
			expect(SlimeCurve.isTouching(10.6, 10, 0.5)).toBeFalsy()
		end)
		it("progress is clamped to 0..1", function()
			expect(SlimeCurve.progress(-50, 0, 100)).toBe(0)
			expect(SlimeCurve.progress(50, 0, 100)).toBeNear(0.5, 1e-9)
			expect(SlimeCurve.progress(500, 0, 100)).toBe(1)
			expect(SlimeCurve.progress(5, 10, 10)).toBe(1)
		end)
	end)

	describe("Powers", function()
		it("dash is free, the rest unlock in cost order", function()
			expect(Powers.isUnlocked("Dash", 0)).toBeTruthy()
			expect(Powers.isUnlocked("DoubleJump", 4)).toBeFalsy()
			expect(Powers.isUnlocked("DoubleJump", 5)).toBeTruthy()
			expect(Powers.isUnlocked("Shield", 11)).toBeFalsy()
			expect(Powers.isUnlocked("Grapple", 20)).toBeTruthy()
		end)
		it("unknown powers are never unlocked", function()
			expect(Powers.isUnlocked("Fly", 9999)).toBeFalsy()
			expect(Powers.def("Fly")).toBe(nil)
		end)
		it("active ids skip passives and keep order", function()
			local ids = Powers.activeIds()
			expect(#ids).toBe(3)
			expect(ids[1]).toBe("Dash")
			for _, id in ids do
				expect(Config.Powers[id].Passive).toBeFalsy()
			end
		end)
		it("cooldown is ready first time and after the wait", function()
			expect(Powers.cooldownReady(nil, 6, 0)).toBeTruthy()
			expect(Powers.cooldownReady(10, 6, 15)).toBeFalsy()
			expect(Powers.cooldownReady(10, 6, 16)).toBeTruthy()
		end)
		it("crowns needed never goes negative", function()
			expect(Powers.crownsNeeded("Grapple", 5)).toBe(15)
			expect(Powers.crownsNeeded("Grapple", 50)).toBe(0)
		end)
	end)

	describe("Crowns", function()
		it("slow escape outside the podium gets the base crown", function()
			expect(Crowns.forEscape(60, 5)).toBe(Config.Crowns.Escape)
		end)
		it("fast first place gets every bonus", function()
			local c = Config.Crowns
			expect(Crowns.forEscape(30, 1)).toBe(c.Escape + c.Speedy + c.PodiumBonus)
		end)
		it("speedy edge counts at exactly the limit", function()
			local c = Config.Crowns
			expect(Crowns.forEscape(c.SpeedySeconds, 9)).toBe(c.Escape + c.Speedy)
		end)
	end)
end
