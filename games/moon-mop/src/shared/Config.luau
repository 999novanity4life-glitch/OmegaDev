--!strict
-- Every tunable number in Moon Mop Co. lives here so designers (and agents) can balance the game
-- without touching logic. Change values, not code.
--
-- Sources: the design doc (/mnt/project-files/moon-cleaning/moon-cleaning-design.html) and the
-- Moon Sweepers guides it cites. Prices marked [orig] are the original's; everything else is our
-- own balance [design]. Studs, kg, dollars and seconds unless a name says otherwise.

local Config = {}

Config.Moon = {
	Radius = 2000, -- matches ServerStorage.MoonMapData.Radius
	Centre = Vector3.new(0, -2000, 0), -- North Station sits on top at the origin
	Gravity = 50, -- studs/s^2 toward the centre (floaty)
	JumpSpeed = 28,
	WalkSpeed = 16,
	BrushSpeedFactor = 0.85, -- walk speed while the tool is on
}

-- Three nested geodesic grids (see MoonGrid). Each frequency divides the next one up.
Config.Grid = {
	PatchFrequency = 320, -- 1,024,002 patches, about 8 studs apart
	SectorFrequency = 64, -- 40,962 sectors (hexes), about 41 studs across
	RegionFrequency = 8, -- 642 regions of about 64 sectors
}

Config.Dust = {
	KgPerStud2 = 0.0026, -- a sector holds about 3.7 kg
	PricePerKg = 1.5, -- raw dust, before Market Contracts
	CleanBelow = 0.1, -- a patch counts as clean once less than this fraction is left
	SampleStep = 1.5, -- server sweep sampling, studs along and across the tool
	MaxSpeedSlack = 1.6, -- segments faster than max speed times this do not clean
	ServerTick = 0.1,
	-- Steep crater walls hold denser Stardust that only brooms reach (worth more).
	StardustSlope = 0.55, -- 1 - up.normal at which ground counts as steep
	StardustMultiplier = 5,
}

Config.Rewards = {
	SectorNear = 10, -- [orig] about $10 early
	SectorFar = 40, -- [orig] $40 later
	SectorFarAngle = 70, -- degrees from the North Station where the reward reaches SectorFar
	Region = 250,
	Flag = 100, -- [orig]
	Probe = 250, -- [orig]
}

